# Board-only defaults plus migration of an existing generated configuration.
# Keep unrelated local values and all other board selections untouched.
set(solar_os_papermono_defaults "${CMAKE_CURRENT_LIST_DIR}/papermono_sleep.defaults")
if((NOT DEFINED SOLAR_OS_BOARD OR SOLAR_OS_BOARD STREQUAL "")
        AND DEFINED ENV{SOLAR_OS_BOARD})
    set(SOLAR_OS_BOARD "$ENV{SOLAR_OS_BOARD}")
endif()
function(solar_os_configure_papermono_sleep)
    if(NOT SOLAR_OS_BOARD STREQUAL "m5paper_mono")
        return()
    endif()
    set(board_defaults "${solar_os_papermono_defaults}")
    if(NOT DEFINED SDKCONFIG_DEFAULTS)
        set(SDKCONFIG_DEFAULTS sdkconfig.defaults)
    endif()
    list(APPEND SDKCONFIG_DEFAULTS "${board_defaults}")
    list(REMOVE_DUPLICATES SDKCONFIG_DEFAULTS)
    set(SDKCONFIG_DEFAULTS "${SDKCONFIG_DEFAULTS}" PARENT_SCOPE)
    if(SDKCONFIG)
        get_filename_component(config "${SDKCONFIG}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
    else()
        set(config "${CMAKE_SOURCE_DIR}/sdkconfig")
    endif()
    if(NOT EXISTS "${config}")
        return()
    endif()
    get_filename_component(config_name "${config}" NAME)
    if(config_name MATCHES "^sdkconfig\\.defaults($|\\.)")
        message(FATAL_ERROR "SDKCONFIG must select a generated configuration, not defaults: ${config}")
    endif()
    file(READ "${config}" contents)
    set(original "${contents}")
    file(STRINGS "${board_defaults}" settings REGEX "^CONFIG_[A-Z0-9_]+=.")
    foreach(setting IN LISTS settings)
        string(REGEX REPLACE "=.*" "" key "${setting}")
        if(setting MATCHES "=n$")
            set(desired "# ${key} is not set")
        else()
            set(desired "${setting}")
        endif()
        string(FIND "\n${contents}" "\n${desired}\n" found)
        if(found EQUAL -1)
            string(REGEX REPLACE "(^|\n)(# ${key} is not set|${key}=[^\n]*)" "\\1" contents "${contents}")
            string(APPEND contents "\n${desired}\n")
        endif()
    endforeach()
    if(NOT contents STREQUAL original)
        file(WRITE "${config}" "${contents}")
        message(NOTICE "SolarOS configuring PaperMono automatic sleep in ${config}")
    endif()
endfunction()
